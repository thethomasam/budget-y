# Tavily API key (required for web search)
TAVILY_API_KEY=

# --- Database (PostgreSQL / Supabase) ---
# Supabase cloud:  postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Self-hosted:     postgresql://budgety:<password>@<db-host>:5432/budgety
DATABASE_URL=postgresql://budgety:budgety@localhost:5432/budgety

POSTGRES_USER=budgety
POSTGRES_PASSWORD=changeme
POSTGRES_DB=budgety

# --- Cross-host service URLs ---
# Set these when running services on separate machines.

# Backend stack (docker-compose.backend.yml)
REDIS_URL=redis://redis:6379/0
OLLAMA_URL=http://<ollama-host>:11434/api/generate

# Frontend stack (docker-compose.frontend.yml)
VITE_BACKEND_URL=http://<backend-host>:8000

# Optional port overrides
# OLLAMA_PORT=11434
# REDIS_PORT=6379
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# DB_PORT=5432
