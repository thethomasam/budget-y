# --- Database (PostgreSQL) ---
# Uses the psycopg3 driver — keep the "+psycopg" in the scheme.
DATABASE_URL=postgresql+psycopg://budgety:budgety@localhost:5432/budgety

POSTGRES_USER=budgety
POSTGRES_PASSWORD=changeme
POSTGRES_DB=budgety

# --- Cross-host service URLs ---
# Set these when running services on separate machines.

# Frontend stack (docker-compose.frontend.yml)
VITE_BACKEND_URL=http://<backend-host>:8000

# --- Backend ---
REMOTE_LEDGER_URL=https://api.samsllama.com
SYNC_INTERVAL_SECONDS=300

# --- Ollama ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Optional port overrides
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# DB_PORT=5432
